# fase3.env.example — Variables de los scripts de la Fase 3 (sin secretos).
#
# Copia este archivo a fase3.env (en la misma carpeta que los scripts) y ajusta lo que
# defina Anthony. Si fase3.env no existe, los scripts usan este archivo tal cual.
#
# Forma  : "${VAR:=valor}"  -> si la variable ya viene en el entorno, se respeta.
#   Ejemplo:  sudo NTP_SERVER=10.0.0.50 bash chrony-cliente.sh
# Las listas van separadas por espacios.

# ------------------------------------------------------------------ VPC y subredes
: "${VPC_CIDR:=10.0.0.0/24}"
: "${SUBNET_MEDICOS:=10.0.0.0/27}"
: "${SUBNET_SERVIDORES:=10.0.0.32/27}"
: "${SUBNET_VISITANTES:=10.0.0.64/27}"
: "${SUBNET_DMZ:=10.0.0.96/28}"
: "${SUBNET_TI:=10.0.0.112/28}"

# ------------------------------------------------------------------ equipos (IPs privadas)
: "${IP_TI:=10.0.0.117}"            # Hospital-EC2-TI
: "${IP_SERVIDORES:=10.0.0.46}"     # Hospital-EC2-Servidores (LDAP, intranet, NTP)
: "${IP_ENDPOINT:=10.0.0.122}"      # EC2 Instance Connect Endpoint (subred TI)
# EC2 de prueba en otras subredes: vacías = esas pruebas se marcan OMITIDA.
: "${IP_MEDICOS:=}"
: "${IP_VISITANTES:=}"
: "${IP_DMZ:=}"                     # p. ej. la NAT instance, si se usa
: "${IP_NAT:=}"

# ------------------------------------------------------------------ NTP (chrony)
: "${NTP_SERVER:=${IP_SERVIDORES}}"            # servidor interno al que apuntan los clientes
: "${NTP_UPSTREAM:=169.254.169.123}"           # Amazon Time Sync (link-local de AWS)
: "${NTP_ALLOW_CIDRS:=${VPC_CIDR}}"            # quién puede consultar al servidor NTP interno
: "${NTP_LOCAL_STRATUM:=10}"                   # respaldo si se pierde el upstream ("" = no)
: "${NTP_SOLO_INTERNO:=si}"                    # cliente: desactiva otras fuentes (si/no)
: "${NTP_RESPALDO_AWS:=no}"                    # cliente: agrega Amazon Time Sync como respaldo (si/no)

# ------------------------------------------------------------------ NAT instance
: "${NAT_SOURCE_CIDRS:=${VPC_CIDR}}"           # subredes que salen a Internet por la NAT

# ------------------------------------------------------------------ hardening (ufw)
: "${SSH_ALLOW_CIDRS:=${SUBNET_TI}}"           # el endpoint llega desde 10.0.0.122 (subred TI)
: "${LDAP_PORT:=389}"
# Según el contrato LDAP de Sebastián (fase3/sebastian/README.md): TCP/389 solo desde Servidores y TI.
: "${LDAP_ALLOW_CIDRS:=${SUBNET_SERVIDORES} ${SUBNET_TI}}"
: "${INTRANET_PORTS:=80}"                      # "80 443" si se usa HTTPS
: "${INTRANET_ALLOW_CIDRS:=${SUBNET_MEDICOS} ${SUBNET_SERVIDORES} ${SUBNET_DMZ} ${SUBNET_TI}}"   # nunca Visitantes
: "${HARDENING_ROLLBACK_SEG:=300}"             # seguro anti-lockout: se revierte solo si no confirmas
# Servicios que se deshabilitan si están corriendo (con confirmación). Los demás solo se listan.
: "${SERVICIOS_DESHABILITAR:=avahi-daemon cups cups-browsed ModemManager bluetooth whoopsie}"

# ------------------------------------------------------------------ pruebas (tests_fase3.sh)
: "${INTRANET_PORT:=80}"
: "${INTRANET_SCHEME:=http}"                   # https si la intranet usa TLS (curl -k)
: "${INTRANET_PATH:=/}"
: "${LDAP_BASE:=dc=hospital,dc=redes,dc=test}"
: "${LDAP_PEOPLE:=ou=People,${LDAP_BASE}}"
# Credenciales LDAP de prueba: SOLO por entorno, nunca en este archivo.
#   export LDAP_USER=ti01; read -rs LDAP_PASS; export LDAP_PASS   (usuario ficticio de Sebastián)
: "${INTERNET_TEST_IP:=1.1.1.1}"
: "${INTERNET_TEST_PORT:=443}"
: "${INTERNET_TEST_URL:=https://example.com}"
: "${TIMEOUT_PRUEBA:=5}"
