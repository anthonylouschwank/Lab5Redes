# Configuración no secreta para los scripts LDAP de Fase 3.
# Copiar fuera del repositorio o exportar estas variables antes de ejecutar.

LDAP_DOMAIN="hospital.redes.test"
LDAP_BASE_DN="dc=hospital,dc=redes,dc=test"
LDAP_ORG_NAME="Hospital Privado Castillejos"

# En el servidor LDAP se recomienda loopback. Los clientes usarán la IP
# privada o el nombre que Anthony confirme para la VPC.
LDAP_URI="ldap://127.0.0.1"
LDAP_ADMIN_DN="cn=admin,dc=hospital,dc=redes,dc=test"

# Usuario ficticio empleado por probar-ldap.sh.
LDAP_TEST_UID="ti01"

