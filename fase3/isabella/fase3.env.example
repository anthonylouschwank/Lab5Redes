# Variables no secretas de la intranet (Fase 3). Copiar como fase3.env en esta carpeta, o exportarlas.
# La contraseña de svc-intranet NUNCA va aquí: se pide con read -s o por LDAP_SERVICE_PASSWORD.

: "${INTRANET_PORT:=80}"                       # D3 (Anthony): HTTP 80
: "${INTRANET_DOCROOT:=/var/www/hospital-intranet}"
: "${INTRANET_SITE:=hospital-intranet}"        # nombre del sitio en sites-available
: "${INTRANET_SERVERNAME:=intranet.hospital.redes.test}"

# Quién puede abrir la intranet (además del SG y de ufw). Nunca Visitantes (10.0.0.64/27).
# Médicos, Servidores, DMZ, TI + loopback para las pruebas en la propia instancia.
: "${INTRANET_ALLOW_CIDRS:=10.0.0.0/27 10.0.0.32/27 10.0.0.96/28 10.0.0.112/28 127.0.0.1 ::1}"

# Contrato LDAP de Sebastián (fase3/sebastian/CONTRATO-APACHE.md)
: "${LDAP_URI:=ldap://127.0.0.1}"
: "${LDAP_BASE_DN:=dc=hospital,dc=redes,dc=test}"
: "${LDAP_BIND_DN:=uid=svc-intranet,ou=People,${LDAP_BASE_DN}}"
: "${LDAP_GRUPOS_INTRANET:=medicos ti laboratorio}"   # acceso a /intranet/
: "${LDAP_GRUPO_TI:=ti}"                              # acceso extra a /intranet/ti/

# Archivo con la contraseña de svc-intranet (root:root 600). Apache lo lee con "exec:" al arrancar.
: "${LDAP_BIND_SECRET:=/etc/apache2/hospital-intranet/ldap-bind.secret}"
