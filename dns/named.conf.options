// /etc/bind/named.conf.options
// BIND9 autoritativo para hospital.redes.test (ver named.conf.local).
// La recursión solo se ofrece a la propia VM y a la red del laboratorio, reenviando
// al DNS del NAT de VirtualBox (10.0.2.3) para nombres fuera de la zona.

acl "red-lab" {
    127.0.0.0/8;
    10.0.0.32/27;
};

options {
    directory "/var/cache/bind";

    listen-on port 53 { 127.0.0.1; 10.0.0.37; };
    listen-on-v6 { none; };

    allow-query     { red-lab; };
    allow-transfer  { none; };

    recursion yes;
    allow-recursion { red-lab; };
    forwarders { 10.0.2.3; };
    forward only;

    // El proxy DNS del NAT de VirtualBox no siempre entrega firmas DNSSEC;
    // se desactiva la validación para no romper la resolución externa (apt).
    dnssec-validation no;

    // No revelar la versión de BIND
    version "no disponible";

    // Registrar cada consulta en el journal (evidencia INT-04)
    querylog yes;
};
