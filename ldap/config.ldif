# Ajustes de cn=config (se aplican con: ldapmodify -Y EXTERNAL -H ldapi:///)

# Registrar conexiones, binds y búsquedas (evidencia de autenticación en el journal)
dn: cn=config
changetype: modify
replace: olcLogLevel
olcLogLevel: stats

# Índice para las búsquedas por correo que hacen Postfix y Dovecot
dn: olcDatabase={1}mdb,cn=config
changetype: modify
add: olcDbIndex
olcDbIndex: mail eq
